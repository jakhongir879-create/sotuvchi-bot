# Bu fayldan nusxa oling: Windows'da `copy .env.example .env`
# Keyin .env ichidagi qiymatlarni o'zingizniki bilan almashtiring.

# Telegram: @BotFather'dan olingan bot tokeni
TELEGRAM_BOT_TOKEN=
# Sizning Telegram ID raqamingiz (@userinfobot'dan bilib oling). Bot faqat sizga javob beradi.
OWNER_TELEGRAM_ID=

# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Apify: https://console.apify.com/account/integrations
APIFY_TOKEN=

# Google Sheets
GOOGLE_CREDENTIALS_FILE=credentials.json
SPREADSHEET_ID=

# Sozlamalar
TIMEZONE=Asia/Tashkent
DAILY_LIMIT=30
